<%# Single render point for every Live/Building/Roadmap claim on the site.
    Routing every product and division reference through here is what keeps the
    honesty constraint structural rather than a matter of careful copy each time.
    "building" sits between the other two: work is actively underway (a named
    product, engineering hours going in) but nothing is shipped yet -- distinct
    from "roadmap," which is direction with no work started. %>
<% if (status === 'live') { %>
  <span class="badge badge--live">Live</span>
<% } else if (status === 'building') { %>
  <span class="badge badge--building">Building</span>
<% } else { %>
  <span class="badge badge--roadmap">Roadmap</span>
<% } %>
