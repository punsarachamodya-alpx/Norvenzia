<%# The homepage, Services, Industries, The Model, About Us, Intelligence
    (Live), and Contact all start with a transparent header over a dark
    hero, so they need the white/"dark-bg" logo variant at load; every
    other page has no dark hero behind it and always renders solid white,
    so it always gets the navy/"light-bg" variant. nav.js swaps the src on
    scroll for the dark-starting pages — see public/js/nav.js. %>
<% var startsOnDark = ['/', '/services', '/industries', '/the-model', '/about-us', '/intelligence', '/contact'].indexOf(currentPath) !== -1; %>
<header class="header <%= startsOnDark ? 'header--transparent' : '' %>">
  <div class="shell header__inner">
    <a class="header__logo" href="/" aria-label="<%= site.publicName %> — home">
      <img src="<%= startsOnDark ? '/brand/norvenzia-logo-dark.svg' : '/brand/norvenzia-logo-light.svg' %>"
           data-logo-light="/brand/norvenzia-logo-light.svg"
           data-logo-dark="/brand/norvenzia-logo-dark.svg"
           alt="Norvenzia" width="337" height="66">
    </a>

    <button class="header__toggle" type="button" id="navToggle"
            aria-expanded="false" aria-controls="primaryNav" aria-label="Open menu">
      <span></span>
    </button>

    <nav class="header__nav" id="primaryNav" aria-label="Primary">
      <% nav.primary.forEach(function (item, i) { %>
        <% if (item.children && item.children.length) { %>
          <%# Expandable item (Operations/Analytics/Risk Management): the
              label itself still links straight to the division page --
              only the caret toggles the dropdown, so "click the word" and
              "click the arrow" both do something reasonable, and a visitor
              who never notices the caret can still get where the label
              says. Click-to-toggle (not hover) on purpose: it's the only
              interaction model that works identically on desktop and the
              touch-only mobile panel, see public/js/main.js. %>
          <div class="header__item">
            <a class="header__link <%= currentPath === item.href ? 'is-current' : '' %>"
               href="<%= item.href %>"
               <%= currentPath === item.href ? 'aria-current="page"' : '' %>><%= item.label %></a>
            <button type="button" class="header__caret" aria-expanded="false" aria-controls="navDropdown<%= i %>" aria-label="Show <%= item.label %> topics"><span></span></button>
            <div class="header__dropdown" id="navDropdown<%= i %>">
              <% item.children.forEach(function (child) { %>
                <a class="header__dropdown-link <%= currentPath === child.href ? 'is-current' : '' %>" href="<%= child.href %>"><%= child.label %></a>
              <% }); %>
            </div>
          </div>
        <% } else { %>
          <a class="header__link <%= currentPath === item.href ? 'is-current' : '' %>"
             href="<%= item.href %>"
             <%= currentPath === item.href ? 'aria-current="page"' : '' %>><%= item.label %></a>
        <% } %>
      <% }); %>
      <a class="btn btn--primary header__cta" href="<%= nav.ctaHref %>"><%= nav.ctaLabel %></a>
    </nav>
  </div>
</header>
