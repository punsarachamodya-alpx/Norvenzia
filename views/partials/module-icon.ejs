<%# Six abstract geometric marks for the homepage's product tabs — node
    diagrams, flow arrows, grid patterns, deliberately not stock photography.
    Same frame convention as industry-icon.ejs: 64x64, brand colours. %>
<svg viewBox="0 0 64 64" fill="none" stroke="var(--color-accent)" stroke-width="2"
     stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
<% if (slug === 'core') { %>
  <%# PO / procurement — a grid of nodes converging on one central hub. %>
  <circle cx="32" cy="32" r="6" fill="var(--color-accent)" stroke="none"/>
  <circle cx="12" cy="14" r="3"/>
  <circle cx="32" cy="10" r="3"/>
  <circle cx="52" cy="14" r="3"/>
  <circle cx="12" cy="50" r="3"/>
  <circle cx="52" cy="50" r="3"/>
  <path d="M14 16 26 28M32 13v13M50 16 38 28M14 48 26 36M50 48 38 36" stroke="var(--color-border)"/>
<% } else if (slug === 'flow') { %>
  <%# Logistics — a directional flow line, tracked. %>
  <path d="M6 20h30" />
  <path d="M28 12l8 8-8 8" />
  <path d="M6 44h30" />
  <path d="M28 36l8 8-8 8" />
  <circle cx="52" cy="20" r="4"/>
  <circle cx="52" cy="44" r="4"/>
<% } else if (slug === 'link') { %>
  <%# Data layer — an interlocking grid. %>
  <rect x="8" y="8" width="20" height="20" rx="2"/>
  <rect x="36" y="8" width="20" height="20" rx="2"/>
  <rect x="8" y="36" width="20" height="20" rx="2"/>
  <rect x="36" y="36" width="20" height="20" rx="2"/>
  <path d="M28 18h8M18 28v8M46 28v8M28 46h8" stroke="var(--color-border)"/>
<% } else if (slug === 'pulse') { %>
  <%# Reporting — a dashboard heartbeat / KPI line. %>
  <path d="M6 34h10l5-14 8 24 5-18 4 8h20" />
  <circle cx="6" cy="34" r="2" fill="var(--color-accent)" stroke="none"/>
  <circle cx="58" cy="34" r="2" fill="var(--color-accent)" stroke="none"/>
<% } else if (slug === 'signal') { %>
  <%# Early-warning visibility — concentric radar rings, not a forecast arrow. %>
  <circle cx="32" cy="32" r="4" fill="var(--color-accent)" stroke="none"/>
  <circle cx="32" cy="32" r="12"/>
  <circle cx="32" cy="32" r="20" stroke="var(--color-border)"/>
  <path d="M32 8v6M32 50v6M8 32h6M50 32h6" stroke="var(--color-border)"/>
<% } else if (slug === 'desk') { %>
  <%# Dedicated analyst — a single seat, committed hours. %>
  <rect x="14" y="14" width="36" height="24" rx="2"/>
  <path d="M20 44h24M26 38v6M38 38v6" />
  <circle cx="32" cy="26" r="5" fill="var(--color-accent)" stroke="none"/>
<% } %>
</svg>
