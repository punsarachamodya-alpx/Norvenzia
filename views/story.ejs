<link rel="stylesheet" href="/css/story.css?v=<%= v %>">

<%
  // `countries`/`currentCountry` are always passed by the /insights/trade/:country
  // route (see server.js) -- a single-option list today, since Sweden is the
  // only populated country, but the dropdown below is wired for more.
  const countryList = Array.isArray(countries) ? countries : [];
  const currentSlug = typeof currentCountry === 'string' ? currentCountry : '';
  const currentEntry = countryList.find(function (c) { return c.slug === currentSlug; }) || null;
  // Falls back to the manifest entry's name when `data` failed to load, so
  // the "unavailable" state still shows which country was requested rather
  // than a generic label.
  const countryName = (data && data.meta && data.meta.country) || (currentEntry && currentEntry.name) || 'Trade';

  function escapeHtml(value) {
    return String(value).replace(/[&<>"']/g, function (ch) {
      return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[ch];
    });
  }

  // Built once as a plain HTML string (rather than an EJS include/partial)
  // since it's needed identically in both the "unavailable" and populated
  // hero states below. Full-page navigation on change, deliberately no
  // client-side fetch/JSON-swap -- this route stays static/SSR-first with
  // zero runtime dependency.
  let countrySwitcherHtml = '';
  if (countryList.length) {
    const options = countryList
      .map(function (c) {
        const selected = c.slug === currentSlug ? ' selected' : '';
        return `<option value="${escapeHtml(c.slug)}"${selected}>${escapeHtml(c.name)}</option>`;
      })
      .join('');
    countrySwitcherHtml =
      '<div class="story__country-switch">' +
      '<label class="story__country-switch-label" for="storyCountrySelect">Country</label>' +
      '<select id="storyCountrySelect" class="story__country-select">' +
      options +
      '</select>' +
      '</div>';
  }
%>

<% if (!data) { %>
  <section class="hero hero--inner">
    <div class="shell">
      <div class="hero__copy">
        <span class="eyebrow">Intelligence · Data Story</span>
        <%- countrySwitcherHtml %>
        <h1 class="display-1" data-letter-reveal><%= countryName %> Trade Intelligence</h1>
      </div>
      <p class="lede">A scroll-driven look at what <%= countryName %> buys from the world, who it depends on, and why that concentration is exactly the kind of risk Norvenzia's Analytics practice is built to surface.</p>
    </div>
  </section>
  <section class="section">
    <div class="shell shell--narrow">
      <div class="live-unavailable reveal">
        <h2 class="display-2">This story is temporarily unavailable</h2>
        <p class="lede">We can't load the underlying dataset right now. Please check back shortly — every other page on this site is unaffected.</p>
      </div>
    </div>
  </section>
<% } else { %>
  <%
    // Mirrors the client-side formatCurrency/formatPct in public/js/story.js --
    // two runtimes, same source numbers, same formatting rules. Never a
    // hardcoded figure: every number these touch comes straight out of the
    // parsed content/trade-data/<code>.json passed in as `data`, and the
    // currency code itself comes from data.meta.currency rather than being
    // hardcoded to SEK.
    function formatCurrency(thousandsValue, currencyCode) {
      if (typeof thousandsValue !== 'number' || !isFinite(thousandsValue)) return null;
      var units = thousandsValue * 1000;
      var abs = Math.abs(units);
      var sign = units < 0 ? '-' : '';
      var code = currencyCode || '';
      if (abs >= 1e12) return sign + code + ' ' + (abs / 1e12).toFixed(2) + 'tn';
      if (abs >= 1e9) return sign + code + ' ' + (abs / 1e9).toFixed(1) + 'bn';
      if (abs >= 1e6) return sign + code + ' ' + (abs / 1e6).toFixed(1) + 'm';
      return sign + code + ' ' + Math.round(abs).toLocaleString('en-US');
    }
    function formatPct(fraction, digits) {
      if (typeof fraction !== 'number' || !isFinite(fraction)) return null;
      return (fraction * 100).toFixed(digits == null ? 1 : digits) + '%';
    }

    const hero = data.hero || {};
    const topGoods = Array.isArray(data.topGoodsCategories) ? data.topGoodsCategories : [];
    const topPartners = Array.isArray(data.topPartners) ? data.topPartners : [];
    const concentration = data.concentration || {};
    const balance = data.balance || {};
    const trend = data.trend || {};
    const dataMeta = data.meta || {};
    const currency = dataMeta.currency || '';
    const fmt = function (thousandsValue) { return formatCurrency(thousandsValue, currency); };

    const hasHero = typeof hero.totalImportsValue === 'number' && typeof hero.totalExportsValue === 'number' && typeof hero.tradeBalanceValue === 'number';
    const hasGoods = topGoods.length > 0;
    const hasPartners = topPartners.length > 0;
    const hasConcentration = typeof concentration.top5PartnerImportShare === 'number';
    const hasGoodsConcentration = typeof concentration.top5GoodsImportShare === 'number';
    const hasBalance = Array.isArray(balance.years) && balance.years.length > 0 && Array.isArray(balance.importsValue) && Array.isArray(balance.exportsValue);
    const hasTrend = Array.isArray(trend.years) && trend.years.length > 0;

    const isSurplus = hasHero && hero.tradeBalanceValue >= 0;
    const topGood = hasGoods ? topGoods[0] : null;
    const topPartner = hasPartners ? topPartners[0] : null;
  %>

  <section class="hero hero--inner">
    <div class="shell">
      <div class="hero__copy">
        <span class="eyebrow">Intelligence · Data Story</span>
        <%- countrySwitcherHtml %>
        <h1 class="display-1" data-letter-reveal><%= countryName %> Trade Intelligence</h1>
      </div>
      <p class="lede">A scroll-driven look at what <%= countryName %> buys from the world, who it depends on, and why that concentration is exactly the kind of risk Norvenzia's Analytics practice is built to surface.</p>
      <p class="crosslink"><a class="arrow-link" href="/live">See the live disruption monitor</a></p>
    </div>
  </section>

  <div class="story" id="story">
    <div class="story__sticky-wrap">
      <div class="story__sticky" id="storySticky">
        <p class="story__stat-value" id="storyStat" aria-hidden="true"></p>
        <p class="story__annotation" id="storyAnnotation" aria-live="polite"></p>
        <svg id="storyGraphic" class="story__svg" viewBox="0 0 640 400" preserveAspectRatio="xMidYMid meet" role="img" aria-label="<%= countryName %> trade chart"></svg>
        <p class="story__caption" id="storyCaption"></p>
      </div>
    </div>

    <div class="story__steps">
      <% if (hasHero) { %>
        <section class="story__step" data-scene="hook">
          <span class="eyebrow">The hook</span>
          <h2 class="display-2">This is everything <%= countryName %> buys from the world</h2>
          <p class="lede">
            In <%= hero.year %>, <%= countryName %> imported <strong><%= fmt(hero.totalImportsValue) %></strong> worth of goods from its trading partners, and sold <strong><%= fmt(hero.totalExportsValue) %></strong> back to them.
          </p>
          <p>
            <% if (isSurplus) { %>
              The result was a trade <strong>surplus</strong> of <%= fmt(Math.abs(hero.tradeBalanceValue)) %>.
            <% } else { %>
              The result was a trade <strong>deficit</strong> of <%= fmt(Math.abs(hero.tradeBalanceValue)) %>.
            <% } %>
            Everything that follows is where that money actually went.
          </p>
          <p class="story__figure-fallback">Imports: <%= fmt(hero.totalImportsValue) %> · Exports: <%= fmt(hero.totalExportsValue) %></p>
        </section>
      <% } %>

      <% if (hasGoods) { %>
        <section class="story__step" data-scene="goods">
          <span class="eyebrow">What <%= countryName %> imports</span>
          <h2 class="display-2"><%= topGood.label %> leads the import bill</h2>
          <p class="lede">
            <%= topGood.label %> is <%= countryName %>'s largest import category at <%= fmt(topGood.importValue) %> — <%= formatPct(topGood.share) %> of everything the country imports.
          </p>
          <p>The next beats show who <%= countryName %> buys that from, and how much of the total sits with just a handful of partners.</p>
          <ul class="story__figure-fallback story__figure-fallback--list">
            <% topGoods.slice(0, 10).forEach(function (g) { %>
              <li><%= g.label %> — <%= fmt(g.importValue) %><% if (typeof g.share === 'number') { %> (<%= formatPct(g.share) %>)<% } %></li>
            <% }); %>
          </ul>
        </section>
      <% } %>

      <% if (hasPartners) { %>
        <section class="story__step" data-scene="partners">
          <span class="eyebrow">Who <%= countryName %> buys from</span>
          <h2 class="display-2"><%= topPartner.label %> is <%= countryName %>'s single biggest supplier</h2>
          <p class="lede">
            <%= countryName %> imported <%= fmt(topPartner.importValue) %> from <%= topPartner.label %> in <%= hero.year %> alone — <%= formatPct(topPartner.share) %> of everything the country bought from abroad.
          </p>
          <p>The next nine partners on this list account for most of the rest — and that clustering is exactly the concentration risk the next beat measures.</p>
          <ul class="story__figure-fallback story__figure-fallback--list">
            <% topPartners.slice(0, 10).forEach(function (p) { %>
              <li><%= p.label %> — <%= fmt(p.importValue) %><% if (typeof p.share === 'number') { %> (<%= formatPct(p.share) %>)<% } %></li>
            <% }); %>
          </ul>
        </section>
      <% } %>

      <% if (hasConcentration) { %>
        <section class="story__step" data-scene="concentration">
          <span class="eyebrow">Concentration risk</span>
          <h2 class="display-2">Five countries, <%= formatPct(concentration.top5PartnerImportShare) %> of the bill</h2>
          <p class="lede">
            <%= countryName %>'s top 5 trading partners account for <%= formatPct(concentration.top5PartnerImportShare) %> of all imports<% if (typeof concentration.top10PartnerImportShare === 'number') { %> — <%= formatPct(concentration.top10PartnerImportShare) %> once you count the top 10<% } %>.
          </p>
          <p>
            <% if (typeof concentration.hhiPartners === 'number') { %>
              The Herfindahl-Hirschman Index across all partners sits at <%= Math.round(concentration.hhiPartners) %> — <%= concentration.hhiPartners >= 1500 ? 'a moderately concentrated' : 'a fairly diversified' %> supplier base by that standard measure.
            <% } %>
            <% if (hasGoodsConcentration) { %>
              The same pattern shows up in goods: the top 5 import categories make up <%= formatPct(concentration.top5GoodsImportShare) %> of the total.
            <% } %>
          </p>
          <p class="story__figure-fallback">Top 5 partners: <%= formatPct(concentration.top5PartnerImportShare) %> · Everyone else: <%= formatPct(Math.max(0, 1 - concentration.top5PartnerImportShare)) %></p>
        </section>
      <% } %>

      <% if (hasBalance) { %>
        <% const lastIdx = balance.years.length - 1; const lastBalance = Array.isArray(balance.balanceValue) ? balance.balanceValue[lastIdx] : null; %>
        <section class="story__step" data-scene="balance">
          <span class="eyebrow">The balance</span>
          <h2 class="display-2">Imports and exports, <%= balance.years[0] %>–<%= balance.years[lastIdx] %></h2>
          <p class="lede">
            <%= countryName %> has swung between trade surplus and deficit over this period.
            <% if (typeof lastBalance === 'number') { %>
              In <%= balance.years[lastIdx] %>, the balance was <%= lastBalance >= 0 ? 'a surplus' : 'a deficit' %> of <%= fmt(Math.abs(lastBalance)) %>.
            <% } %>
          </p>
          <ul class="story__figure-fallback story__figure-fallback--list">
            <% balance.years.forEach(function (year, i) { %>
              <li><%= year %> — Imports <%= fmt(balance.importsValue[i]) %>, Exports <%= fmt(balance.exportsValue[i]) %></li>
            <% }); %>
          </ul>
        </section>
      <% } %>

      <% if (hasTrend) { %>
        <% const lastTrendIdx = trend.years.length - 1; const lastImportGrowth = Array.isArray(trend.importGrowthPct) ? trend.importGrowthPct[lastTrendIdx] : null; %>
        <section class="story__step" data-scene="trend">
          <span class="eyebrow">The trend</span>
          <h2 class="display-2">Year-over-year swings, <%= trend.years[0] %>–<%= trend.years[lastTrendIdx] %></h2>
          <p class="lede">
            <% if (typeof lastImportGrowth === 'number') { %>
              Imports moved <%= lastImportGrowth >= 0 ? 'up' : 'down' %> <%= Math.abs(lastImportGrowth).toFixed(1) %>% year-over-year in <%= trend.years[lastTrendIdx] %>.
            <% } else { %>
              Both imports and exports have moved in sharp year-over-year swings across this period — shocks, recoveries, and everything between.
            <% } %>
          </p>
          <ul class="story__figure-fallback story__figure-fallback--list">
            <% trend.years.forEach(function (year, i) { %>
              <li><%= year %> — Imports <%= typeof trend.importGrowthPct[i] === 'number' ? (trend.importGrowthPct[i] >= 0 ? '+' : '') + trend.importGrowthPct[i].toFixed(1) + '%' : '—' %>, Exports <%= typeof trend.exportGrowthPct[i] === 'number' ? (trend.exportGrowthPct[i] >= 0 ? '+' : '') + trend.exportGrowthPct[i].toFixed(1) + '%' : '—' %></li>
            <% }); %>
          </ul>
        </section>
      <% } %>

      <section class="story__step" data-scene="sowhat">
        <span class="eyebrow">So what</span>
        <h2 class="display-2">National-scale volatility, company-scale exposure</h2>
        <p class="lede">
          A country the size of <%= countryName %> tracks this — thousands of suppliers, shifting shares, real concentration risk — with a national statistics office and a monthly reporting cycle. A mid-market company carries the same exposure on a spreadsheet nobody has time to rebuild every week.
        </p>
        <p>
          This is the analysis Norvenzia runs continuously for a single business: Spend Analysis to see where the money actually goes, Vendor Performance to track who's reliable, Inventory Analytics and Demand Planning to catch concentration risk before it becomes a disruption. The rigor above is the same rigor we apply — the difference is we run it for one company, every week, not once for a whole nation.
        </p>
        <div class="btn-row">
          <a class="btn btn--primary" href="/contact">Book a call</a>
          <a class="arrow-link" href="/services">See the Analytics service line</a>
        </div>
      </section>
    </div>
  </div>

  <p class="story__provenance">
    Data: <% if (dataMeta.sourceUrl) { %><a href="<%= dataMeta.sourceUrl %>" target="_blank" rel="noopener noreferrer"><%= dataMeta.source || countryName %></a><% } else { %><%= dataMeta.source || countryName %><% } %><% if (dataMeta.latestYear) { %> · <%= dataMeta.latestYear %> figures<% } %> · refreshed monthly<% if (dataMeta.generatedAt) { %> · generated <%= new Date(dataMeta.generatedAt).toISOString().slice(0, 10) %><% } %>
  </p>

  <%# Server-rendered dataset for the sticky-graphic upgrade -- public/js/story.js
      reads this instead of re-fetching anything (this page has zero runtime
      dependency on the source statistics API). < escaping prevents a
      label/source string containing "</script>" from breaking out of this
      JSON island -- same pattern as views/live.ejs's #live-initial-data island. %>
  <script type="application/json" id="story-data"><%- JSON.stringify(data).replace(/</g, '\\u003c') %></script>
  <script src="/js/vendor/d3.v7.min.js" defer></script>
  <script src="/js/story-engine.js?v=<%= v %>" defer></script>
  <script src="/js/story.js?v=<%= v %>" defer></script>
<% } %>
