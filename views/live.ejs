<link rel="stylesheet" href="/css/vendor/maplibre-gl.css">

<%# Full-bleed photo hero with a transparent header overlaid, same
    treatment as the other rebuilt pages — a live ops-style world map
    display, matching what this page actually shows. %>
<section class="work-hero work-hero--dark-nav">
  <picture>
    <source media="(max-width: 640px)" srcset="/img/photos/live-hero-mobile.jpg">
    <img class="work-hero__img" src="/img/photos/live-hero.jpg" alt="" aria-hidden="true" width="1920" height="1072" data-parallax="36">
  </picture>
  <span class="work-hero__scrim" aria-hidden="true"></span>
  <div class="shell work-hero__inner">
    <span class="eyebrow">Live</span>
    <h1 class="display-1 work-hero__headline">Global Disruption Monitor</h1>
    <p class="lede work-hero__body">Real-time supply chain disruptions — port strikes, weather, geopolitical restrictions, and logistics failures — classified and scored as they're detected.</p>
    <p class="crosslink"><a class="arrow-link arrow-link--onNavy" href="/insights/sweden-trade">Read the Sweden Trade Intelligence data story</a></p>
  </div>
</section>

<% if (!misAvailable) { %>
  <section class="section">
    <div class="shell shell--narrow">
      <div class="live-unavailable reveal">
        <h2 class="display-2">Live monitor temporarily unavailable</h2>
        <p class="lede">We can't reach the intelligence service right now. Please check back shortly — every other page on this site is unaffected.</p>
      </div>
    </div>
  </section>
<% } else { %>
  <section class="section">
    <div class="shell">
      <%# MapLibre GL renders into this container -- see public/js/live.js.
          Basemap is CARTO's free dark-matter vector style, fetched
          client-side from *.basemaps.cartocdn.com (named CSP exception in
          server.js). Shipping lanes are real, static maritime geography
          (public/geo/shipping-lanes.geojson -- see public/geo/README.md for
          source/license), not generated or illustrative. %>
      <div id="live-globe" class="world-map reveal">
        <div class="world-map__legend" aria-hidden="true">
          <span class="world-map__legend-group">
            <span class="world-map__legend-label">Severity</span>
            <span class="world-map__legend-swatch world-map__legend-swatch--1">1</span>
            <span class="world-map__legend-swatch world-map__legend-swatch--2">2</span>
            <span class="world-map__legend-swatch world-map__legend-swatch--3">3</span>
            <span class="world-map__legend-swatch world-map__legend-swatch--4">4</span>
            <span class="world-map__legend-swatch world-map__legend-swatch--5">5</span>
          </span>
          <span class="world-map__legend-group">
            <span class="world-map__legend-line"></span>
            <span class="world-map__legend-label">Major shipping lanes</span>
          </span>
          <% if (vessels.length > 0) { %>
            <span class="world-map__legend-group">
              <span class="world-map__legend-vessel"></span>
              <span class="world-map__legend-label">Live ships</span>
            </span>
          <% } %>
        </div>
        <p class="world-map__updated" data-role="last-updated" aria-live="polite"></p>
      </div>
      <%# Opt-in map-level filtering (public/js/live.js wires the click
          handlers and the actual MapLibre source filtering). Every chip
          starts unpressed -- the map shows every event by default, exactly
          as before this existed, unless a visitor deliberately presses one.
          This is a separate control from the feed's own search/sort above
          the "Recent events" list further down the page: this one narrows
          what the *map* draws, that one only reorders/narrows the *list*. %>
      <div class="live-map-filters" data-role="map-filters">
        <span class="live-map-filters__intro">Filter map (optional)</span>
        <div class="live-map-filters__group" role="group" aria-label="Filter map by category">
          <span class="live-map-filters__label">Category</span>
          <%# Fixed 7-value enum from lib/misContract.js's CATEGORY_ENUM --
              MIS's contract, not something derived from whatever events
              happen to be present right now. %>
          <% ['weather', 'geopolitical', 'labor', 'logistics', 'regulatory', 'supplier', 'other'].forEach(function (cat) { %>
            <button type="button" class="live-map-filters__chip" data-filter-type="category" data-filter-value="<%= cat %>" aria-pressed="false"><%= cat %></button>
          <% }); %>
        </div>
        <div class="live-map-filters__group" role="group" aria-label="Filter map by severity">
          <span class="live-map-filters__label">Severity</span>
          <% [1, 2, 3, 4, 5].forEach(function (sev) { %>
            <button type="button" class="live-map-filters__chip live-map-filters__chip--severity" data-filter-type="severity" data-filter-value="<%= sev %>" aria-pressed="false"><%= sev %></button>
          <% }); %>
        </div>
        <div class="live-map-filters__status-row" data-role="map-filter-status-row" hidden>
          <span data-role="map-filter-status-text"></span>
          <button type="button" class="live-map-filters__clear" data-role="map-filter-clear">Clear filter</button>
        </div>
      </div>
      <p class="world-map__caption">
        Shipping lanes are real maritime corridors (<a href="https://doi.org/10.5281/zenodo.6361763" target="_blank" rel="noopener noreferrer">Global Shipping Lanes dataset</a>, CC BY-SA 4.0), not live vessel tracking.
        <% if (vessels.length > 0) { %>
          Ship positions are live AIS data via aisstream.io.
        <% } %>
      </p>
    </div>
  </section>

  <%# War Room feature explainer -- the "Investigate" action only lives
      inside a clicked event's popup, so a visitor who never clicks a
      marker has no way to discover it exists. This section makes the
      capability visible regardless. Slide 1 of the preview below is a real
      screenshot of the live disruption map. Slides 2-4 are NOT screenshots
      -- they reuse the exact CSS classes public/js/live-warroom.js renders
      a real result with (warroom-impact-badge, warroom-impact-strip,
      warroom-sources, warroom-table, warroom-actions) with static,
      clearly-labeled illustrative content, each marked "Example output --
      illustrative" and aria-hidden as decorative (this site's "No
      photography" honesty constraint applies here too -- no fabricated
      content passed off as real) -- just the product's own real UI with
      example data. %>
  <section class="section section--warroom-intro">
    <div class="shell">
      <div class="warroom-intro">
        <div class="warroom-intro__copy">
          <span class="eyebrow">War Room</span>
          <h2 class="display-2">Turn any disruption into an actionable briefing</h2>
          <p class="lede">Click any marker on the map above, then choose <strong>Investigate</strong>. An AI agent researches that specific incident across news, government, port authority, and social sources, and returns a structured, cited briefing — who's affected, who isn't, and what to do next.</p>
          <ul class="warroom-intro__features">
            <li><strong>Multi-source research</strong> — news, government, port authority, and social sources, searched live for the one incident you clicked.</li>
            <li><strong>Every claim cited</strong> — affected and unaffected entries link back to a real source; nothing is asserted without one.</li>
            <li><strong>Affected vs. unaffected breakdown</strong> — suppliers, ports, shipping lines, and manufacturers, so you see the full picture, not just the bad news.</li>
            <li><strong>Recommended next actions</strong> — concrete, urgency-ranked steps grounded in what the research actually found.</li>
          </ul>
          <% if (!warroomUnlocked) { %>
            <p class="warroom-intro__cta">
              <a class="btn btn--primary btn--sm" href="/contact?topic=warroom" target="_blank" rel="noopener noreferrer">Request access</a>
              <% if (warroomBookingEmbedUrl) { %>
                <a class="btn btn--ghost btn--sm" href="<%= warroomBookingEmbedUrl %>" target="_blank" rel="noopener noreferrer">Schedule a demo</a>
              <% } %>
            </p>
          <% } %>
        </div>
        <div class="warroom-intro__preview">
          <div class="warroom-slider">
            <button type="button" class="warroom-slider__nav warroom-slider__nav--prev" aria-label="Previous slide">&#8249;</button>
            <div class="warroom-slider__track" id="warroom-slider-track">
              <figure class="warroom-slider__slide">
                <img src="/img/warroom/warroom-map-overview.jpg" alt="The live global disruption map, showing real-time supply chain incidents plotted worldwide" loading="lazy">
                <figcaption>Real-time disruptions plotted on the global map</figcaption>
              </figure>
              <%# Slides 2-4: not screenshots -- the real .warroom-impact-badge/
                  -strip/-sources/-table/-actions classes buildImpactStrip(),
                  buildSourcesPanel(), buildCategoryTable() and buildActionsList()
                  in public/js/live-warroom.js render a live result with, reused
                  here with static sample data and marked aria-hidden since
                  they're decorative illustrations, not real findings. %>
              <figure class="warroom-slider__slide warroom-slider__slide--panel" aria-hidden="true">
                <p class="warroom-slider__slide-label">Example output — illustrative</p>
                <div class="warroom-impact-badge warroom-impact-badge--severe">
                  <span class="warroom-impact-badge__icon">!!</span>
                  <div class="warroom-impact-badge__text">
                    <strong class="warroom-impact-badge__label">Severe impact</strong>
                    <p class="warroom-impact-badge__reason">A key regional port suspended operations, creating significant disruption risk for shipping routes through the area.</p>
                  </div>
                </div>
                <div class="warroom-impact-strip">
                  <span class="warroom-impact-strip__item">
                    <span class="warroom-impact-strip__tag">PRT</span>
                    <span class="warroom-impact-strip__count">1</span>
                    <span class="warroom-impact-strip__label">Ports</span>
                  </span>
                  <span class="warroom-impact-strip__item">
                    <span class="warroom-impact-strip__tag">SHL</span>
                    <span class="warroom-impact-strip__count">2</span>
                    <span class="warroom-impact-strip__label">Shipping lines</span>
                  </span>
                </div>
                <figcaption>Example: an AI-assessed impact verdict, not a guess</figcaption>
              </figure>
              <figure class="warroom-slider__slide warroom-slider__slide--panel" aria-hidden="true">
                <p class="warroom-slider__slide-label">Example output — illustrative</p>
                <div class="warroom-sources">
                  <h4 class="warroom-table__heading">11 sources</h4>
                  <div class="warroom-sources__chips">
                    <span class="warroom-sources__chip">6 government</span>
                    <span class="warroom-sources__chip">5 news</span>
                  </div>
                </div>
                <div class="warroom-table">
                  <h4 class="warroom-table__heading">Affected ports</h4>
                  <ul class="warroom-table__list">
                    <li class="warroom-table__row">
                      <span class="warroom-table__name">Example Port Authority</span>
                      <span class="warroom-table__confidence warroom-table__confidence--high">high</span>
                      <a class="warroom-table__source" href="https://example.com" target="_blank" rel="noopener noreferrer">Source: example.com (illustrative)</a>
                    </li>
                  </ul>
                </div>
                <figcaption>Example: every claim is cited — never asserted without a source</figcaption>
              </figure>
              <figure class="warroom-slider__slide warroom-slider__slide--panel" aria-hidden="true">
                <p class="warroom-slider__slide-label">Example output — illustrative</p>
                <div class="warroom-actions">
                  <h4 class="warroom-table__heading">Recommended actions</h4>
                  <ul class="warroom-actions__list">
                    <li class="warroom-actions__item">
                      <span class="warroom-actions__urgency warroom-actions__urgency--high">high</span>
                      <p class="warroom-actions__action">Line up a backup carrier for the affected route before the current booking window closes.</p>
                      <p class="warroom-actions__rationale">The primary shipping line has no confirmed alternative routing yet.</p>
                    </li>
                    <li class="warroom-actions__item">
                      <span class="warroom-actions__urgency warroom-actions__urgency--medium">medium</span>
                      <p class="warroom-actions__action">Notify downstream customers of a likely delay window.</p>
                      <p class="warroom-actions__rationale">The affected port has no announced reopening date.</p>
                    </li>
                  </ul>
                </div>
                <figcaption>Example: urgency-ranked next actions, grounded in the research</figcaption>
              </figure>
            </div>
            <button type="button" class="warroom-slider__nav warroom-slider__nav--next" aria-label="Next slide">&#8250;</button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <%# Recent events feed -- a separate section, after the War Room
      explainer above (not nested inside the map section), so a long list
      of events never buries the explainer beneath it. live.js's
      renderFeed() rebuilds .live-feed__list client-side on every poll and
      applies the search/sort controls below; this server-rendered markup
      is just the first-paint state (identical shape, so there's no
      flash-of-different-content on load). %>
  <section class="section">
    <div class="shell">
      <div class="live-feed">
        <div class="live-feed__header">
          <h2 class="display-2">Recent events</h2>
          <div class="live-feed__controls">
            <label class="visually-hidden" for="live-feed-search">Search recent events</label>
            <input type="search" id="live-feed-search" class="live-feed__search" placeholder="Search by location, category, or summary…" autocomplete="off">
            <label class="visually-hidden" for="live-feed-sort">Sort recent events</label>
            <select id="live-feed-sort" class="live-feed__sort">
              <option value="newest">Newest first</option>
              <option value="severity-desc">Severity: high to low</option>
              <option value="severity-asc">Severity: low to high</option>
            </select>
          </div>
        </div>
        <p class="live-feed__count" data-role="feed-count" aria-live="polite"></p>
        <ul class="live-feed__list">
          <% events.forEach(function (e) { %>
            <li class="live-feed__item" data-event-id="<%= e.id %>" tabindex="0" role="button" aria-label="Show this disruption on the map">
              <span class="live-feed__severity live-feed__severity--<%= e.severity %>"><%= e.severity %></span>
              <span class="live-feed__category"><%= e.category %></span>
              <span class="live-feed__location"><%= e.location %></span>
              <p class="live-feed__summary"><%= e.summary %></p>
              <% if (e.sourceUrl) { %>
                <a class="live-feed__source" href="<%= e.sourceUrl %>" target="_blank" rel="noopener noreferrer">Source</a>
              <% } %>
            </li>
          <% }); %>
        </ul>
      </div>
    </div>
  </section>

  <%# Server-rendered snapshot for first paint; live.js polls /live/data (a
      same-origin proxy — MIS's real address is never sent to the browser)
      for updates. < escaping prevents a summary/title containing
      "</script>" from breaking out of this JSON island. %>
  <script type="application/json" id="live-initial-data"><%- JSON.stringify(events).replace(/</g, '\\u003c') %></script>
  <script type="application/json" id="live-initial-vessels"><%- JSON.stringify(vessels).replace(/</g, '\\u003c') %></script>
  <%# War Room gating state for the "Investigate" popup action
      (public/js/live-warroom.js) — session-scoped, never a real service
      address. See docs/internal/WARROOM_BUILD_PLAN.md §10. %>
  <script type="application/json" id="live-warroom-state"><%- JSON.stringify({
    unlocked: Boolean(warroomUnlocked),
    requestAccessHref: '/contact?topic=warroom',
    bookingEmbedUrl: warroomBookingEmbedUrl || ''
  }).replace(/</g, '\\u003c') %></script>
  <script src="/js/vendor/maplibre-gl-csp.js" defer></script>
  <script src="/js/live-warroom.js?v=<%= v %>" defer></script>
  <script src="/js/live.js?v=<%= v %>" defer></script>
<% } %>
