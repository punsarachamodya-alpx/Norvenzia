<%# Full-bleed photo hero with a transparent header overlaid, same
    treatment as the homepage, Services, and Industries. %>
<section class="work-hero work-hero--dark-nav">
  <picture>
    <source media="(max-width: 640px)" srcset="/img/photos/banner-team-mobile.jpg">
    <img class="work-hero__img" src="/img/photos/banner-team.jpg" alt="" aria-hidden="true" width="1920" height="1071" data-parallax="36">
  </picture>
  <span class="work-hero__scrim" aria-hidden="true"></span>
  <div class="shell work-hero__inner">
    <span class="eyebrow"><%= page.hero.eyebrow %></span>
    <h1 class="display-1 work-hero__headline" data-letter-reveal><%= page.hero.headline %></h1>
    <p class="lede work-hero__body"><%= page.hero.body %></p>
  </div>
</section>

<section class="section">
  <div class="shell">
    <%# Text and cards side by side instead of stacked — the section-head's
        copy is only ever ~40ch wide, so stacking the cards underneath it
        left a wide dead strip beside the text at desktop widths. %>
    <div class="model-layout">
      <div class="section-head reveal model-layout__copy" style="margin-bottom:0;">
        <span class="eyebrow"><%= page.model.eyebrow %></span>
        <h2 class="display-2"><%= page.model.headline %></h2>
        <% page.model.body.forEach(function (para) { %>
          <p class="lede"><%= para %></p>
        <% }); %>
      </div>

      <div class="split split--model model-layout__cards">
        <% page.model.panels.forEach(function (p) { %>
          <article class="panel panel--model reveal">
            <% if (p.image) { %>
              <div class="panel__media">
                <img src="<%= p.image %>" alt="" loading="lazy" width="800" height="450">
              </div>
            <% } %>
            <div class="panel__inner">
              <span class="panel__label"><%= p.label %></span>
              <h3 class="panel__place"><%= p.place %></h3>
              <p class="panel__body"><%= p.body %></p>
            </div>
          </article>
        <% }); %>
      </div>
    </div>
  </div>
</section>

<%- include('partials/cta-band', { closing: page.closing }) %>
