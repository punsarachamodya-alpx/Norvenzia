<%# Full-bleed photo hero, same family as the other rebuilt pages —
    a real operations team in place of the plain text-only inner hero. %>
<section class="work-hero">
  <img class="work-hero__img" src="/img/photos/banner-team.jpg" alt="" aria-hidden="true" width="1920" height="1071">
  <span class="work-hero__scrim" aria-hidden="true"></span>
  <div class="shell work-hero__inner">
    <span class="eyebrow"><%= page.hero.eyebrow %></span>
    <h1 class="display-1 work-hero__headline"><%= page.hero.headline %></h1>
    <p class="lede work-hero__body"><%= page.hero.body %></p>
  </div>
</section>

<section class="section">
  <div class="shell">
    <div class="section-head reveal">
      <span class="eyebrow"><%= page.model.eyebrow %></span>
      <h2 class="display-2"><%= page.model.headline %></h2>
      <% page.model.body.forEach(function (para) { %>
        <p class="lede"><%= para %></p>
      <% }); %>
    </div>

    <div class="split">
      <% page.model.panels.forEach(function (p) { %>
        <article class="panel panel--model reveal">
          <% if (p.image) { %>
            <div class="panel__media">
              <img src="<%= p.image %>" alt="" loading="lazy" width="800" height="450">
            </div>
          <% } %>
          <div class="panel__inner">
            <span class="panel__label"><%= p.label %></span>
            <h3 class="panel__place"><%= p.place %></h3>
            <p class="panel__body"><%= p.body %></p>
          </div>
        </article>
      <% }); %>
    </div>
  </div>
</section>

<section class="section section--alt">
  <div class="shell">
    <div class="section-head reveal">
      <span class="eyebrow"><%= page.methodology.eyebrow %></span>
      <h2 class="display-2"><%= page.methodology.headline %></h2>
      <p class="lede"><%= page.methodology.body %></p>
    </div>

    <div class="steps">
      <% page.methodology.stages.forEach(function (s) { %>
        <div class="step reveal">
          <div class="step__number"><%= s.number %></div>
          <h3 class="step__title"><%= s.title %></h3>
          <p class="step__body"><%= s.body %></p>
        </div>
      <% }); %>
    </div>
  </div>
</section>

<section class="section">
  <div class="shell">
    <div class="section-head reveal">
      <span class="eyebrow"><%= page.security.eyebrow %></span>
      <h2 class="display-2"><%= page.security.headline %></h2>
      <p class="lede"><%= page.security.body %></p>
    </div>

    <%# The in-place / not-yet-true split is structural, so an unearned claim has
        nowhere to sit. ISO 27001 and SOC 2 are named explicitly as not yet held. %>
    <div class="split">
      <article class="panel panel--plain reveal">
        <div class="panel__inner">
          <span class="panel__label"><%= page.security.inPlaceLabel %></span>
          <ul class="posture-list posture-list--yes">
            <% page.security.inPlace.forEach(function (i) { %>
              <li><%= i %></li>
            <% }); %>
          </ul>
        </div>
      </article>
      <article class="panel panel--plain panel--roadmap reveal">
        <div class="panel__inner">
          <span class="panel__label"><%= page.security.roadmapLabel %></span>
          <ul class="posture-list posture-list--no">
            <% page.security.roadmap.forEach(function (i) { %>
              <li><%= i %></li>
            <% }); %>
          </ul>
        </div>
      </article>
    </div>
  </div>
</section>

<%# Native <details>, not a JS accordion: it expands, is keyboard-operable, and
    is findable by in-page search with no script at all — consistent with the rest
    of the site, where JavaScript only ever enhances. %>
<section class="section">
  <div class="shell">
    <div class="section-head reveal">
      <span class="eyebrow"><%= page.faq.eyebrow %></span>
      <h2 class="display-2"><%= page.faq.headline %></h2>
    </div>

    <div class="faq">
      <% page.faq.items.forEach(function (item) { %>
        <details class="faq__item reveal">
          <summary class="faq__q"><%= item.question %></summary>
          <p class="faq__a"><%= item.answer %></p>
        </details>
      <% }); %>
    </div>
  </div>
</section>

<%- include('partials/cta-band', { closing: page.closing }) %>
