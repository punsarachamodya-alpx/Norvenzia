<%- include('partials/hero') %>

<%# 3.2 — Social proof strip %>
<section class="social-proof">
  <div class="shell">
    <span class="social-proof__eyebrow"><%= page.socialProof.eyebrow %></span>
    <div class="social-proof__chips">
      <% page.socialProof.verticals.forEach(function (v) { %>
        <span class="social-proof__chip"><%= v %></span>
      <% }); %>
    </div>
    <p class="social-proof__markets"><%= page.socialProof.markets %></p>
  </div>
</section>

<%# Who Norvenzia serves — asymmetric photo + copy split %>
<section class="home-section who-serve">
  <div class="shell home-section__inner">
    <h2 class="home-section__heading"><%= page.whoServe.headline %></h2>

    <div class="who-serve__grid">
      <div class="who-serve__media photo-slot" data-photo-hint="<%= page.whoServe.photoHint %>" role="img" aria-label="Team reviewing a plan together"></div>
      <div class="who-serve__aside">
        <span class="who-serve__accent" aria-hidden="true"></span>
        <p class="who-serve__body"><%= page.whoServe.body %></p>
        <a class="btn btn--primary btn--pill" href="<%= page.whoServe.cta.href %>"><%= page.whoServe.cta.label %> →</a>
      </div>
    </div>
  </div>
</section>

<%# Full-bleed photo banner %>
<section class="banner-photo photo-slot" data-photo-hint="<%= page.banner.photoHint %>" role="img" aria-label="Operations team at work">
  <span class="banner-photo__scrim" aria-hidden="true"></span>
  <div class="shell banner-photo__inner">
    <h2 class="banner-photo__headline"><%= page.banner.headline %></h2>
  </div>
</section>

<%# 3.3 — Services / six modules, alternating full-photo + bullet-list rows %>
<section class="home-section" id="services">
  <div class="shell home-section__inner">
    <span class="eyebrow"><%= page.services.eyebrow %></span>
    <h2 class="home-section__heading"><%= page.services.headline %></h2>
    <p class="home-section__body"><%= page.services.body %></p>

    <div class="service-rows">
      <% page.services.items.forEach(function (item, i) { %>
        <article class="service-row <%= i % 2 === 1 ? 'service-row--reverse' : '' %>">
          <div class="service-row__media photo-slot" data-photo-hint="<%= item.photoHint %>" role="img" aria-label="<%= item.name %>"></div>
          <div class="service-row__copy">
            <span class="service-row__category"><%= item.category %></span>
            <h3 class="service-row__name"><%= item.name %></h3>
            <ul class="service-row__list">
              <% item.bullets.forEach(function (b) { %>
                <li><%= b %></li>
              <% }); %>
            </ul>
            <a class="btn btn--ghost btn--pill" href="#contact">Talk to us →</a>
          </div>
        </article>
      <% }); %>
    </div>
  </div>
</section>

<%# 3.4 — Three entry-point tiers, numbered 01/02/03 %>
<section class="home-section" id="tiers">
  <div class="shell home-section__inner">
    <span class="eyebrow"><%= page.tiers.eyebrow %></span>
    <h2 class="home-section__heading"><%= page.tiers.headline %></h2>

    <div class="tier-cards">
      <% page.tiers.items.forEach(function (tier) { %>
        <article class="tier-card">
          <span class="tier-card__number"><%= tier.number %></span>
          <span class="tier-card__label"><%= tier.label %></span>
          <h3 class="tier-card__name"><%= tier.name %></h3>
          <p class="tier-card__body"><%= tier.body %></p>
          <a class="tier-card__link" href="<%= tier.link.href %>"><%= tier.link.label %> →</a>
          <% if (tier.note) { %>
            <p class="tier-card__note"><%= tier.note %></p>
          <% } %>
        </article>
      <% }); %>
    </div>
  </div>
</section>

<%# 3.5 — How it works, three steps (dark) %>
<section class="section--home-dark" id="how">
  <div class="shell home-section__inner">
    <span class="eyebrow"><%= page.how.eyebrow %></span>
    <h2 class="home-section__heading"><%= page.how.headline %></h2>

    <div class="how-steps">
      <% page.how.steps.forEach(function (step) { %>
        <div>
          <span class="how-step__number"><%= step.number %></span>
          <h3 class="how-step__title"><%= step.title %></h3>
          <p class="how-step__body"><%= step.body %></p>
        </div>
      <% }); %>
    </div>
  </div>
</section>

<%# 3.6 — Stats row %>
<section class="home-section">
  <div class="shell home-section__inner">
    <div class="stats-row">
      <% page.stats.items.forEach(function (stat) { %>
        <div class="stat">
          <div class="stat__value"><%= stat.value %></div>
          <div class="stat__label"><%= stat.label %></div>
        </div>
      <% }); %>
    </div>
  </div>
</section>

<%# 3.7 — Editorial quote block (dark) %>
<section class="quote-block">
  <div class="shell quote-block__inner">
    <h3 class="quote-block__headline">&ldquo;<%= page.quote.headline %>&rdquo;</h3>
    <p class="quote-block__body"><%= page.quote.body %></p>
  </div>
</section>

<%# 3.8 — About %>
<section class="home-section" id="about">
  <div class="shell home-section__inner">
    <span class="eyebrow"><%= page.about.eyebrow %></span>
    <h2 class="home-section__heading"><%= page.about.headline %></h2>

    <div class="about-grid">
      <div class="about-grid__body">
        <% page.about.body.forEach(function (para) { %>
          <p><%= para %></p>
        <% }); %>
      </div>
      <div class="about-grid__visual photo-slot" data-photo-hint="<%= page.about.photoHint %>" role="img" aria-label="The Norvenzia team"></div>
    </div>
  </div>
</section>

<%# 3.9 — FAQ accordion %>
<section class="home-section" id="faq">
  <div class="shell home-section__inner">
    <span class="eyebrow"><%= page.faq.eyebrow %></span>
    <h2 class="home-section__heading"><%= page.faq.headline %></h2>

    <div class="faq-list">
      <% page.faq.items.forEach(function (item, i) { %>
        <div class="faq-item">
          <button type="button" class="faq-item__trigger" aria-expanded="false" aria-controls="faq-panel-<%= i %>">
            <span><%= item.question %></span>
            <span class="faq-item__icon" aria-hidden="true"></span>
          </button>
          <div class="faq-item__panel" id="faq-panel-<%= i %>" aria-hidden="true">
            <div class="faq-item__panel-inner"><%= item.answer %></div>
          </div>
        </div>
      <% }); %>
    </div>
  </div>
</section>

<%# 3.10 — Contact CTA %>
<section class="home-section contact-cta" id="contact">
  <div class="shell home-section__inner">
    <h2 class="home-section__heading"><%= page.contactCta.headline %></h2>
    <p class="contact-cta__body"><%= page.contactCta.body %></p>

    <div class="contact-cta__actions">
      <a class="btn btn--primary btn--pill" href="mailto:<%= site.contactEmail %>"><%= site.contactEmail %></a>
      <a class="contact-cta__secondary" href="<%= page.contactCta.bookingHref %>"><%= page.contactCta.bookingNote %></a>
    </div>
  </div>
</section>
