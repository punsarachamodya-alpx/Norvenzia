<%# Full-bleed photo hero with a transparent header overlaid, same
    treatment as the homepage. %>
<section class="work-hero work-hero--dark-nav">
  <picture>
    <source media="(max-width: 640px)" srcset="/img/photos/what-we-do-hero-mobile.jpg">
    <img class="work-hero__img" src="/img/photos/what-we-do-hero.jpg" alt="" aria-hidden="true" width="1920" height="1072" data-parallax="36">
  </picture>
  <span class="work-hero__scrim" aria-hidden="true"></span>
  <div class="shell work-hero__inner">
    <span class="eyebrow"><%= page.hero.eyebrow %></span>
    <h1 class="display-1 work-hero__headline" data-letter-reveal><%= page.hero.headline %></h1>
    <p class="lede work-hero__body"><%= page.hero.body %></p>
  </div>
</section>

<%# Alternating full-photo + intro-copy pattern, one row per live division
    (Operations, Analytics, Risk Management) — Digital & AI and Advisory
    have no page to send visitors to yet, so they aren't shown here (see
    the homepage and About Us's roadmap table for where they're still
    listed). Each row's body is that division's own page intro (see
    content/operations.js etc., attached as `intro` in server.js), so this
    page and its three division pages never carry two different summaries
    of the same thing.
    The compact photo column (see .service-row--compact) leaves a lot of
    plain white space beside the copy — a faint architectural backdrop
    fills that without competing with the text, since it sits at low
    opacity behind everything rather than as a foreground element. %>
<section class="section division-section">
  <img class="division-section__bg" src="/img/photos/architectural.jpg" alt="" aria-hidden="true">
  <div class="shell" style="position:relative;">
    <div class="service-rows">
      <% var divisionPhotos = {
        Operations: '/img/photos/service-core.jpg',
        Analytics: '/img/photos/service-pulse.jpg',
        'Risk Management': '/img/photos/service-flow.jpg'
      }; %>
      <%# `divisions` (not `page.divisions`) -- the res.locals copy has each
          live division's `intro` paragraph attached (see server.js). %>
      <% var liveDivisions = divisions.filter(function (d) { return d.status === 'live'; }); %>
      <% liveDivisions.forEach(function (d, i) { %>
        <article class="service-row service-row--compact <%= i % 2 === 1 ? 'service-row--reverse' : '' %>">
          <div class="service-row__media <%= i % 2 === 1 ? 'reveal-right' : 'reveal-left' %>">
            <img src="<%= divisionPhotos[d.name] || '/img/photos/service-core.jpg' %>" alt="<%= d.name %>" width="1024" height="768">
          </div>
          <div class="service-row__copy">
            <h2 class="service-row__name"><%= d.name %></h2>
            <p class="home-section__body" style="margin-bottom:1.2rem;"><%= d.intro %></p>
            <% if (d.href) { %>
              <a class="arrow-link" style="margin-top:1.2rem;" href="<%= d.href %>">Explore <%= d.name %></a>
            <% } %>
          </div>
        </article>
      <% }); %>
    </div>
  </div>
</section>


<section class="section">
  <div class="shell">
    <div class="section-head reveal">
      <span class="eyebrow"><%= page.tiers.eyebrow %></span>
      <h2 class="display-2"><%= page.tiers.headline %></h2>
      <p class="lede"><%= page.tiers.body %></p>
    </div>

    <div class="tier-cards reveal-group">
      <% page.tiers.items.forEach(function (t) { %>
        <article class="tier-card">
          <h3 class="tier-card__name"><%= t.name %></h3>
          <p class="tier-card__body"><%= t.summary %></p>
          <ul class="service-row__list" style="margin-top:0.8rem;">
            <% t.includes.forEach(function (i) { %>
              <li><%= i %></li>
            <% }); %>
          </ul>
          <a class="tier-card__link" href="/contact"><%= page.tiers.ctaLabel %> →</a>
        </article>
      <% }); %>
    </div>
  </div>
</section>

<%- include('partials/cta-band', { closing: page.closing }) %>
