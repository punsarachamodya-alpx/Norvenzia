<%# Collage hero: two overlapping real photos instead of stock art or an
    illustration, paired with the copy rather than sitting behind it (keeps
    contrast/legibility solid). %>
<section class="hero hero--collage">
  <div class="shell hero-collage__inner">
    <div class="hero-collage__copy">
      <span class="eyebrow"><%= page.hero.eyebrow %></span>
      <h1 class="display-1 hero-collage__headline" data-letter-reveal><%= page.hero.headline %></h1>
      <p class="lede hero-collage__body"><%= page.hero.body %></p>
    </div>
    <div class="hero-collage__media">
      <div class="hero-collage__tile hero-collage__tile--a reveal-pop">
        <img src="/img/photos/collage-a.jpg" alt="" width="1600" height="1194">
      </div>
      <div class="hero-collage__tile hero-collage__tile--b reveal-right">
        <img src="/img/photos/collage-b.jpg" alt="" width="1600" height="1194">
      </div>
    </div>
  </div>
</section>

<%# Moved here from the homepage — same markup/classes as before. %>
<section class="about-backdrop" id="about">
  <img class="about-backdrop__image" src="/img/photos/about.jpg" alt="" aria-hidden="true" width="1600" height="1200">
  <span class="about-backdrop__scrim" aria-hidden="true"></span>
  <div class="shell about-backdrop__inner">
    <span class="eyebrow eyebrow--onDark"><%= page.about.eyebrow %></span>
    <h2 class="home-section__heading about-backdrop__heading"><%= page.about.headline %></h2>

    <div class="about-backdrop__body">
      <% page.about.body.forEach(function (para) { %>
        <p><%= para %></p>
      <% }); %>
    </div>
  </div>
</section>

<section class="section section--alt">
  <div class="shell">
    <div class="section-head reveal">
      <span class="eyebrow"><%= page.approach.eyebrow %></span>
      <h2 class="display-2 about-approach__heading"><%= page.approach.headline %></h2>
      <p class="lede"><%= page.approach.body %></p>
    </div>

    <div class="steps">
      <% page.approach.stages.forEach(function (s) { %>
        <div class="step reveal">
          <div class="step__number"><%= s.number %></div>
          <h3 class="step__title"><%= s.title %></h3>
          <p class="step__body"><%= s.body %></p>
        </div>
      <% }); %>
    </div>
  </div>
</section>

<section class="section">
  <div class="shell">
    <div class="section-head reveal">
      <span class="eyebrow"><%= page.security.eyebrow %></span>
      <h2 class="display-2"><%= page.security.headline %></h2>
      <p class="lede"><%= page.security.body %></p>
    </div>

    <div class="split">
      <article class="panel panel--plain reveal">
        <div class="panel__inner">
          <span class="panel__label"><%= page.security.inPlaceLabel %></span>
          <ul class="posture-list posture-list--yes">
            <% page.security.inPlace.forEach(function (i) { %>
              <li><%= i %></li>
            <% }); %>
          </ul>
        </div>
      </article>
      <article class="panel panel--plain panel--roadmap reveal">
        <div class="panel__inner">
          <span class="panel__label"><%= page.security.roadmapLabel %></span>
          <ul class="posture-list posture-list--no">
            <% page.security.roadmap.forEach(function (i) { %>
              <li><%= i %></li>
            <% }); %>
          </ul>
        </div>
      </article>
    </div>
  </div>
</section>

<%# Full-bleed photo band, same treatment as the homepage's banner-photo. %>
<section class="banner-photo">
  <img class="banner-photo__img" src="/img/photos/conversation-band.jpg" alt="" aria-hidden="true" width="1600" height="1194">
  <span class="banner-photo__scrim" aria-hidden="true"></span>
  <div class="shell banner-photo__inner">
    <h2 class="banner-photo__headline">Small enough that you talk to the person doing the work, not an account manager relaying it.</h2>
  </div>
</section>

<%# A bold photo bleeding off the edge, paired with the mission statement —
    replaces the plain navy pullquote band with a real-photo split. %>
<section class="statement-split">
  <div class="statement-split__media">
    <img src="/img/photos/architectural.jpg" alt="" width="1600" height="893" data-parallax="30">
  </div>
  <div class="statement-split__copy">
    <div>
      <span class="eyebrow">Mission</span>
      <p class="statement-split__text"><%= page.mission.statement %></p>
    </div>
  </div>
</section>

<section class="section">
  <div class="shell">
    <div class="section-head reveal">
      <span class="eyebrow"><%= page.roadmap.eyebrow %></span>
      <h2 class="display-2"><%= page.roadmap.headline %></h2>
      <p class="lede"><%= page.roadmap.body %></p>
    </div>

    <div class="table-scroll reveal">
      <table class="data-table">
        <thead>
          <tr>
            <th scope="col">Division</th>
            <th scope="col">Scope</th>
          </tr>
        </thead>
        <tbody>
          <% divisions.forEach(function (d) { %>
            <tr>
              <td><%= d.name %></td>
              <td><%= d.summary %></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  </div>
</section>

<%# Founder + team -- moved to the bottom of the page, just before the
    closing CTA, so the roadmap/mission story leads and the "who's behind
    it" detail closes the page instead of opening it. %>
<section class="section">
  <div class="shell">
    <div class="section-head reveal">
      <span class="eyebrow"><%= page.founder.eyebrow %></span>
      <h2 class="display-2"><%= page.founder.headline %></h2>
    </div>

    <div class="founder">
      <div class="founder__portrait reveal">
        <% if (page.founder.photo) { %>
          <img src="<%= page.founder.photo %>" alt="<%= page.founder.name %>" width="480" height="600">
        <% } else { %>
          <%= page.founder.name.split(' ').map(function (w) { return w[0]; }).slice(0, 2).join('') %>
        <% } %>
      </div>

      <div class="founder__story reveal">
        <% page.founder.story.forEach(function (para) { %>
          <p><%= para %></p>
        <% }); %>

        <% if (page.founder.draftNotice) { %>
          <div class="notice">
            <span class="notice__label">Note</span>
            <span><%= page.founder.draftNotice %> — this account will be rewritten in the founder’s own words.</span>
          </div>
        <% } %>

        <div class="founder__meta">
          <p style="font-family:var(--font-display);font-weight:800;font-size:1.1rem;letter-spacing:-0.02em;"><%= page.founder.name %></p>
          <p class="person__role"><%= page.founder.role %></p>
          <% if (page.founder.linkedin) { %>
            <a class="person__link" href="<%= page.founder.linkedin %>" rel="noopener noreferrer" target="_blank">LinkedIn</a>
          <% } %>
        </div>
      </div>
    </div>
  </div>
</section>

<% if (page.team && page.team.members && page.team.members.length) { %>
<section class="section section--alt">
  <div class="shell">
    <div class="section-head reveal">
      <span class="eyebrow"><%= page.team.eyebrow %></span>
      <h2 class="display-2"><%= page.team.headline %></h2>
    </div>

    <div class="people">
      <% page.team.members.forEach(function (m) { %>
        <article class="person reveal">
          <div class="person__portrait">
            <% if (m.photo) { %>
              <img src="<%= m.photo %>" alt="<%= m.name %>" width="84" height="84">
            <% } else { %>
              <%= m.name.split(' ').map(function (w) { return w[0]; }).slice(0, 2).join('') %>
            <% } %>
          </div>
          <div>
            <h3 class="person__name"><%= m.name %></h3>
            <p class="person__role"><%= m.role %></p>
            <% if (m.quote) { %>
              <p class="person__quote"><%= m.quote %></p>
            <% } %>
            <% if (m.linkedin) { %>
              <a class="person__link" href="<%= m.linkedin %>" rel="noopener noreferrer" target="_blank">LinkedIn</a>
            <% } %>
          </div>
        </article>
      <% }); %>
    </div>
  </div>
</section>
<% } %>

<section class="section">
  <div class="shell">
    <div class="section-head reveal">
      <span class="eyebrow"><%= page.faq.eyebrow %></span>
      <h2 class="display-2"><%= page.faq.headline %></h2>
    </div>

    <div class="faq">
      <% page.faq.items.forEach(function (item) { %>
        <details class="faq__item reveal">
          <summary class="faq__q"><%= item.question %></summary>
          <p class="faq__a"><%= item.answer %></p>
        </details>
      <% }); %>
    </div>
  </div>
</section>

<%- include('partials/cta-band', { closing: page.closing }) %>
