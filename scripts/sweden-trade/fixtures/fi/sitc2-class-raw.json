{"id":"V5","label":"Indicators",
"class":[
{"code":"V1","text":"Value (euro);;Statistical value of selected time period (month, quarter, year). Freight and insurance costs for the goods up to the place of exportation at the Finnish border included in the export statistical value (FOB value). Freight and insurance costs up to the first crossing point at the Finnish border included in the import statistical value (CIF value)."},
{"code":"V2","text":"Change%;;Change of statistical value compared to corresponding time period previous year."},
{"code":"V3","text":"Quantity;;Net quantity of the goods. In most cases kilograms if available."},
{"code":"V4","text":"Quantity unit code;;Number code of the quantity unit (e.g. 1=kg). List of unit codes can be found behind the i-button at the top of the page."},
{"code":"V5","text":"Value/Quantity;;Statistical value divided by quantity (statistical unit value, e.g. eur/kg)."},
{"code":"V6","text":"Supplementary quantity;;Some goods have a supplementary quantity unit like piece, pair, square metre etc."},
{"code":"V7","text":"Supplementary quantity unit code;;Supplementary quantity unit code (e.g. 33=piece). List of unit codes can be found behind the i-button at the top of the page."},
{"code":"V8","text":"Value/Supplementary quantity;;Statistical value divided by supplementary quantity (statistical unit value, e.g. eur/piece)."},
{"code":"V9","text":"Cum. value (euro) from the beginning of the year;;Cumulative statistical value of selected time period from the beginning of the year (months or quarters aggregated)."},
{"code":"V9O","text":"Cum. share%;;Percentage of the cumulative statistical value for selected product category of total exports or imports."},
{"code":"V10","text":"Cum. change%;;Change of cumulative statistical value compared to the corresponding time period previous year."},
{"code":"V11","text":"Cum. quantity;;Cumulative quantity from the beginning of the year. Net quantity of the goods. In most cases kilograms if available."},
{"code":"V12","text":"Cum. value/Cum. quantity;;Cumulative statistical value divided by cumulative supplementary quantity (statistical unit value, e.g. eur/piece)."},
{"code":"V13","text":"Cum. Supplementary quantity;;Cumulative supplementary quantity from the beginning of the year. Some goods have a supplementary quantity unit like piece, pair, square metre etc."},
{"code":"V14","text":"Cum. value/Cum. Supplementary quantity;;Cumulative statistical value divided by cumulative supplementary quantity (statistical unit value, e.g. eur/piece)."}
]}
